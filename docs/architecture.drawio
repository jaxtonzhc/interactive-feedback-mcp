<mxfile>
  <diagram name="Architecture" id="arch">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Interactive Feedback MCP - 架构图" style="text;align=center;fontStyle=1;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="600" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="agent_box" value="AI Agent (Cursor/Augment/Claude)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="300" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="mcp_container" value="MCP Server (server.py)" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="170" width="800" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="tool_fn" value="interactive_feedback()&#xa;MCP 工具入口" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="mcp_container">
          <mxGeometry x="20" y="40" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="normalize" value="_normalize_feedback_inputs()&#xa;参数兼容/归一化" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="mcp_container">
          <mxGeometry x="20" y="110" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="heartbeat" value="心跳 &amp; 防重复&#xa;_active_process&#xa;_heartbeat_count&#xa;_build_heartbeat_msg()" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="mcp_container">
          <mxGeometry x="210" y="40" width="170" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="spawn" value="_spawn_feedback_ui_process()&#xa;子进程启动" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="mcp_container">
          <mxGeometry x="210" y="130" width="170" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="format_result" value="_format_feedback_result()&#xa;结果格式化 + 图片" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="mcp_container">
          <mxGeometry x="210" y="200" width="170" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="project_detect" value="_detect_caller_project_context()&#xa;_get_caller_git_info()&#xa;项目/Git 探测" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="mcp_container">
          <mxGeometry x="420" y="40" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="logging" value="logging_system&#xa;init_logging()&#xa;get_logger()&#xa;log_performance()" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="mcp_container">
          <mxGeometry x="640" y="40" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="legacy" value="launch_feedback_ui_async()&#xa;(旧版同步等待，保留)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;dashed=1;fontSize=10;" vertex="1" parent="mcp_container">
          <mxGeometry x="640" y="130" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e_agent_tool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="agent_box" target="tool_fn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_tool_norm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="mcp_container" source="tool_fn" target="normalize">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_tool_hb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="mcp_container" source="tool_fn" target="heartbeat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_tool_spawn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="mcp_container" source="tool_fn" target="spawn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_spawn_detect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="mcp_container" source="spawn" target="project_detect">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_tool_format" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;" edge="1" parent="mcp_container" source="tool_fn" target="format_result">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="ui_container" value="UI 子进程 (enhanced_feedback_ui.py)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="800" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="ui_main" value="ThreeColumnFeedbackUI&#xa;(QMainWindow)&#xa;三栏主窗口" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="ui_container">
          <mxGeometry x="280" y="40" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="left_panel" value="左区: Summary&#xa;EnhancedTextBrowser&#xa;(Markdown 渲染)" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="ui_container">
          <mxGeometry x="20" y="120" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="bottom_panel" value="底部: Reply&#xa;FeedbackTextEdit&#xa;(文字+粘贴图片)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="ui_container">
          <mxGeometry x="200" y="120" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="right_panel" value="右区: Actions&#xa;Git Info + 预定义选项&#xa;(QCheckBox)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="ui_container">
          <mxGeometry x="380" y="120" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="styles" value="Styles&#xa;enhanced_glassmorphism&#xa;glassmorphism&#xa;modern_glassmorphism&#xa;dark_theme" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="ui_container">
          <mxGeometry x="570" y="40" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="utils" value="Utils&#xa;config_manager&#xa;performance&#xa;responsive&#xa;logging_system" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="ui_container">
          <mxGeometry x="570" y="130" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="widgets" value="Widgets&#xa;FeedbackTextEdit&#xa;(IME/粘贴/Submit信号)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="ui_container">
          <mxGeometry x="200" y="210" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="md_renderer" value="EnhancedMarkdownRenderer&#xa;(python-markdown + Pygments)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="ui_container">
          <mxGeometry x="20" y="210" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="data_viz" value="DataVisualization&#xa;(QtCharts 饼图/柱状图)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="ui_container">
          <mxGeometry x="380" y="210" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e_main_left" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="ui_container" source="ui_main" target="left_panel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_main_bottom" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="ui_container" source="ui_main" target="bottom_panel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_main_right" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="ui_container" source="ui_main" target="right_panel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_main_styles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;" edge="1" parent="ui_container" source="ui_main" target="styles">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_main_utils" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;" edge="1" parent="ui_container" source="ui_main" target="utils">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_left_md" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="ui_container" source="left_panel" target="md_renderer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_bottom_widget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="ui_container" source="bottom_panel" target="widgets">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_right_dataviz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;" edge="1" parent="ui_container" source="right_panel" target="data_viz">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_spawn_ui" value="subprocess.exec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontStyle=1;fontSize=10;" edge="1" parent="1" source="spawn" target="ui_main">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="json_file" value="临时 JSON 文件&#xa;(feedback_result)" style="shape=document;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="130" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e_ui_json" value="写入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="ui_main" target="json_file">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="60" y="540"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_json_format" value="读取" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="json_file" target="format_result">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="105" y="395"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_hb_agent" value="心跳消息" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=0;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="heartbeat" target="agent_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="130"/>
              <mxPoint x="720" y="95"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="session_box" value="Session 工具 (可选)&#xa;session_metrics_collector&#xa;session_integration&#xa;session_analysis_tool" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#cccccc;dashed=1;fontColor=#999999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="830" width="220" height="70" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
